# Database Configuration
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/business_gap_finder

# Application Settings
API_HOST=0.0.0.0
API_PORT=8000
DEBUG=true

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000/api

# Crawler Settings
CRAWLER_MAX_CONCURRENCY=10
CRAWLER_BROWSER_CONCURRENCY=2
CRAWLER_TIMEOUT=30
CRAWLER_MAX_PAGES_PER_SITE=6
CRAWLER_USER_AGENT=BusinessGapFinder/1.0 (+https://github.com/example/business-gap-finder)

# Rate Limiting
RATE_LIMIT_REQUESTS_PER_SECOND=5
DOMAIN_RATE_LIMIT_DELAY=1

# Cache Settings
CACHE_TTL_CITY=86400
CACHE_TTL_BOUNDARY=604800
CACHE_TTL_OVERTURE=604800
CACHE_TTL_OSM=86400

# Security
ALLOWED_HOSTS=localhost,127.0.0.1

# Optional API Keys (not required for baseline functionality)
# GOOGLE_PLACES_API_KEY=
# MAPBOX_API_KEY=
# NOMINATIM_EMAIL=
